RECALL_OWNER_PHONE=
RECALL_SENDER_PHONE=
RECALL_PUBLIC_URL=
RECALL_OWNER_CONSENT=no
RECALL_MONTHLY_SMS_SEGMENTS=0
RECALL_TOLL_FREE=false
RECALL_LIVE_AI=false
